# Supabase Configuration
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Project REST/Auth URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Publishable key (anon/public key) — safe to expose in browser bundles
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret key (service role key) — server-only, bypasses RLS
# NEVER use in client components or expose to the browser
SUPABASE_SECRET_KEY="sb_secret_..."
