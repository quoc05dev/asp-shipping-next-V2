# Copy to .env.local for local development, or .env for Docker Compose.
# NEVER commit real secrets.

# PostgreSQL. For Docker Compose use the service hostname "db".
DATABASE_URL="postgres://asp:change-me@db:5432/asp"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-at-least-32-random-characters"
BETTER_AUTH_URL="https://example.com"

# CMS data source: "local" (mock data, default) or "postgres" (real DB)
CMS_PROVIDER="local"

# Used once by `npm run create:admin` to bootstrap the first admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_ROLE="SUPER_ADMIN"

# Docker Compose only
POSTGRES_DB="asp"
POSTGRES_USER="asp"
POSTGRES_PASSWORD="change-me"
DOMAIN="example.com"
