*.tsbuildinfo
next-env.d.ts

# scratch and cleanup artifacts
/scratch/
/node.zip
/git-setup.exe
/nvm-setup.exe
/node.msi
/.vscode/
/data/cms/temp_data.json
/public/screenshot.png
/public/screenshot2.png

